# ReviewFlow AI Backend Environment Configuration

PRODUCT_NAME="ReviewFlow AI"
TAGLINE="From Product URL to Multilingual Review Intelligence — Automatically."

# Database
DATABASE_URL="sqlite+aiosqlite:///./reviewflow.db"

# Security
SECRET_KEY="reviewflow-ai-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Configuration (Optional - Synthetic Engine is active out of the box)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"
USE_SYNTHETIC_FALLBACK=True

# Thresholds
DEFAULT_QUALITY_THRESHOLD=75.0
DEFAULT_SIMILARITY_THRESHOLD=0.70
